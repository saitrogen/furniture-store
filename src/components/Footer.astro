---
import { getDepartments, getWhatsAppUrl, site } from "@/lib/catalog";

const departments = getDepartments().slice(0, 6);
---

<footer class="border-t bg-muted/40">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
      <div>
        <a href="/" class="text-xl font-semibold text-foreground">{site.name}</a>
        <p class="mt-3 max-w-md text-sm leading-6 text-muted-foreground">
          {site.tagline} Browse the catalogue online and enquire directly through WhatsApp.
        </p>
        <a
          href={getWhatsAppUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
        >
          WhatsApp enquiry
        </a>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-foreground">Collection</h3>
        <ul class="flex flex-col gap-3">
          {departments.map((department) => (
            <li>
              <a href={`/collection/${department.slug}`} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                {department.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-foreground">Pages</h3>
        <ul class="flex flex-col gap-3">
          <li><a href="/about" class="text-sm text-muted-foreground transition-colors hover:text-foreground">About</a></li>
          <li><a href="/delivery" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Delivery</a></li>
          <li><a href="/contact" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Contact</a></li>
          <li><a href="/terms" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Terms</a></li>
          <li><a href="/privacy" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col justify-between gap-4 border-t border-border pt-8 text-sm text-muted-foreground md:flex-row md:items-center">
      <p>© 2026 {site.name}. All rights reserved.</p>
      <p>{site.location} · Static catalogue website</p>
    </div>
  </div>
</footer>
