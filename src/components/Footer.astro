---
import Container from "@/components/homeix/Container.astro";

const infoLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Shipping & Returns", href: "/shipping" },
  { label: "Maintenance Guide", href: "/maintenance" },
];
---

<footer class="border-t border-border/40 mt-20">
  <Container class="py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Brand -->
    <div class="flex flex-col gap-3">
      <span class="font-display text-2xl tracking-[0.2em] text-primary"
        >HOMEIX</span
      >
      <p class="text-xs tracking-[0.2em] text-muted-foreground uppercase">
        Living Concept
      </p>
      <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
        © 2024 HOMEIX — Living Concept.<br />
        Crafted in Nilambur.
      </p>
    </div>

    <!-- Info Links -->
    <div class="flex flex-col gap-4">
      <p
        class="text-[11px] font-semibold tracking-[0.2em] uppercase text-muted-foreground"
      >
        Info
      </p>
      <nav class="flex flex-col gap-3">
        {
          infoLinks.map(({ label, href }) => (
            <a
              href={href}
              class="text-sm text-foreground/70 hover:text-primary transition-colors duration-200"
            >
              {label}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Contact -->
    <div class="flex flex-col gap-4">
      <p
        class="text-[11px] font-semibold tracking-[0.2em] uppercase text-muted-foreground"
      >
        Support
      </p>
      <div class="flex flex-col gap-3 text-sm text-foreground/70">
        <a
          href="https://wa.me/919961612120"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors duration-200"
        >
          Chat on WhatsApp
        </a>
        <a
          href="tel:+919961612120"
          class="hover:text-primary transition-colors duration-200"
        >
          +91 9961612120
        </a>
        <span>Open from 10:00 AM</span>
      </div>
    </div>
  </Container>
</footer>
