---
import { navSections, navLinks } from "@/content/localData/nav";
import { getWhatsAppUrl } from "@/lib/catalog";

const year = new Date().getFullYear();
const whatsapp = getWhatsAppUrl();

/* Show top-level sections (Furniture, Lighting…) as "Shop" links */
const shopLinks = navSections
  .filter((s) => !["new-arrivals", "sale"].includes(s.slug))
  .map((s) => ({ label: s.name, href: `/collection/${s.slug}` }));

const legalLinks = [
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
];
---

<footer class="border-t border-border bg-muted/30">

  <!-- Trust strip -->
  <div class="border-b border-border bg-background">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-2 px-6 py-3.5 text-xs font-medium uppercase tracking-wider text-muted-foreground sm:justify-between">
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-base">local_shipping</span>
        Free delivery & installation
      </span>
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-base">verified</span>
        5-Year craftsmanship warranty
      </span>
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-base">autorenew</span>
        Hassle-free returns
      </span>
    </div>
  </div>

  <!-- Main footer -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-6">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr]">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <!-- Logo -->
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="flex size-8 items-center justify-center rounded-sm border-[2.2px] border-primary text-primary">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2.2"/>
              <rect x="11.5" y="1.5" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2.2"/>
              <rect x="1.5" y="11.5" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2.2"/>
            </svg>
          </span>
          <span class="font-heading text-xl font-semibold tracking-tight text-foreground">HOMEIX</span>
        </a>

        <p class="mt-4 max-w-xs text-sm leading-6 text-muted-foreground">
          Premium handcrafted furniture from Nilambur, Kerala.
          Factory-direct to your home — no middlemen, no markups.
        </p>

        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
        >
          <span class="material-symbols-outlined text-[18px]">chat</span>
          WhatsApp enquiry
        </a>
      </div>

      <!-- Shop links -->
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-foreground">
          Shop
        </h3>
        <ul class="flex flex-col gap-2.5">
          {shopLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pages + legal -->
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-foreground">
          Company
        </h3>
        <ul class="flex flex-col gap-2.5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col justify-between gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <p>© {year} HOMEIX. All rights reserved.</p>
      <p>Nilambur, Kerala, India</p>
    </div>
  </div>
</footer>
