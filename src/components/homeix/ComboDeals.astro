        items: [
            "Premium Teak Bed",
            "3-Door Wardrobe",
            "Orthopedic Mattress",
            "Hand-tufted Carpet",
            "Designer Accent Chairs",
            "Matching Teapoy",
        ],
        price: "₹1,49,999",
        badge: "Best Value",
    },
    {
        title: "Living Room Combo",
        image: "https://lh3.googleusercontent.com/aida-public/AB6AXuASV_DTLQYnFfyIGOEkXUn04KsSYUZ0VA-hRaG5oByVW6Q-H1vmn86dgu-gBGd9bKD3NbWx7NuQ6LOgq11CHmGCLoiJ7b71myiFxcicui5khmOURPolw9Bdcngs6UCoK5XsxOtzYRyIFBzm8xpo1MhO58aOnFobDZyF_uoAMpUu_SIHzyxJdDPB0fFAWW8znUgN2kTl_IKSaT06vAQe6WqO4vSoF7Ac3RpX5S6VjJhtjCBlcV1L1RVY001_bIWMTgYdOJ1HtTVVAkc5",
