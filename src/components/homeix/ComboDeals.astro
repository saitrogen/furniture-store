---

<section class="py-20 md:py-28 border-t border-border">
    <Container>
        <div class="mb-10 text-center">
            <p class="text-[11px] uppercase tracking-[0.35em] text-primary">
                Exclusive Combo Deals
            </p>
            <h2 class="mt-4 font-display text-3xl md:text-5xl text-foreground">
                Curated bundles, unmatched value
            </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {combos.map((combo) => <ComboDealCard {...combo} />)}
        </div>
    </Container>
</section>
