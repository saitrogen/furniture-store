---
import Container from "./Container.astro";

interface Props {
    title?: string;
}

const { title = "Get in Touch" } = Astro.props;
---

<section class="py-20 md:py-28 border-t border-border">
    <Container>
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-10">
                <p class="text-[11px] uppercase tracking-[0.35em] text-primary">
                    Enquiries
                </p>
                <h2
                    class="mt-4 font-display text-3xl md:text-4xl text-foreground"
                >
                    {title}
                </h2>
            </div>
            <form class="grid gap-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <label
                        class="flex flex-col gap-2 text-[11px] uppercase tracking-[0.2em] text-primary"
                    >
                        Name
                        <input
                            type="text"
                            placeholder="Enter your name"
                            class="bg-transparent border-0 border-b border-input py-2 text-foreground placeholder:text-muted-foreground focus:border-ring focus:ring-0"
                        />
                    </label>
                    <label
                        class="flex flex-col gap-2 text-[11px] uppercase tracking-[0.2em] text-primary"
                    >
                        Phone Number
                        <input
                            type="tel"
                            placeholder="+91 00000 00000"
                            class="bg-transparent border-0 border-b border-input py-2 text-foreground placeholder:text-muted-foreground focus:border-ring focus:ring-0"
                        />
                    </label>
                </div>
                <label
                    class="flex flex-col gap-2 text-[11px] uppercase tracking-[0.2em] text-primary"
                >
                    Product Interest
                    <select
                        class="bg-transparent border-0 border-b border-input py-2 text-foreground focus:border-ring focus:ring-0"
                    >
                        <option value="" disabled selected
                            >Choose a category</option
                        >
                        <option value="sofas">Sofas</option>
                        <option value="beds">Beds</option>
                        <option value="wardrobes">Wardrobes</option>
                        <option value="dining">Dining</option>
                        <option value="combo">Combo Deals</option>
                        <option value="other">Other</option>
                    </select>
                </label>
                <label
                    class="flex flex-col gap-2 text-[11px] uppercase tracking-[0.2em] text-primary"
                >
                    Message
                    <textarea
                        rows={4}
                        placeholder="Tell us about your requirements"
                        class="bg-transparent border-0 border-b border-input py-2 text-foreground placeholder:text-muted-foreground focus:border-ring focus:ring-0 resize-none"
                    ></textarea>
                </label>
                <button
                    type="submit"
                    class="border border-primary bg-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary-foreground transition hover:opacity-90"
                >
                    Send Enquiry
                </button>
            </form>
        </div>
    </Container>
</section>
