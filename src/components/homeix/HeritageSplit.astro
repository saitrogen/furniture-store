---
import Container from "./Container.astro";

const heritageImage =
    "https://lh3.googleusercontent.com/aida-public/AB6AXuA_OYNvMn-PSdBvMdrtllIX5WzMl-CDOceHKONkWLvrJL42fMN8pzjOoGuGWt1iUaf_Q2X7w46bpqdMAS_po_c_eNtjWQnbsyD8A5e4kiUA024xnQIgDfIHKQYm5s2RNgbE13rwAnEwJeAkWexR9eZnCMLpSkS4_CZmQ7ZC7FtAhmOc_D7RbUFHVeQTsTna8UkajVDPxCu1RVG__PyC2wxjykttskl0QzoRupC0OG6jN_EJCKCyBOhdSF0ZEtjYI62ppBGscX6TVHjb";
---

<section class="py-20 md:py-28 border-t border-border">
    <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="flex flex-col gap-6">
                <div>
                    <p
                        class="text-[11px] uppercase tracking-[0.35em] text-primary"
                    >
                        Our Heritage
                    </p>
                    <h2
                        class="mt-4 font-display text-3xl md:text-5xl text-foreground"
                    >
                        Teak traditions, reimagined
                    </h2>
                </div>
                <p class="text-base md:text-lg text-muted-foreground">
                    Every HOMEIX piece celebrates Nilambur’s legendary teak
                    craftsmanship, pairing rich grain with architectural
                    clarity. We honor tradition while shaping modern
                    sanctuaries.
                </p>
                <a
                    href="/collections"
                    class="inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary-foreground transition hover:opacity-90 w-fit"
                >
                    Discover the Process
                </a>
            </div>
            <div
                class="overflow-hidden border border-border bg-card aspect-3/4"
            >
                <img
                    src={heritageImage}
                    alt="Nilambur craftsmanship"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
            </div>
        </div>
    </Container>
</section>
