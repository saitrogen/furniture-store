---
import Container from "./Container.astro";

const heroImage =
    "https://lh3.googleusercontent.com/aida-public/AB6AXuASV_DTLQYnFfyIGOEkXUn04KsSYUZ0VA-hRaG5oByVW6Q-H1vmn86dgu-gBGd9bKD3NbWx7NuQ6LOgq11CHmGCLoiJ7b71myiFxcicui5khmOURPolw9Bdcngs6UCoK5XsxOtzYRyIFBzm8xpo1MhO58aOnFobDZyF_uoAMpUu_SIHzyxJdDPB0fFAWW8znUgN2kTl_IKSaT06vAQe6WqO4vSoF7Ac3RpX5S6VjJhtjCBlcV1L1RVY001_bIWMTgYdOJ1HtTVVAkc5";
---

<section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <img
        src={heroImage}
        alt="Luxury HOMEIX living room"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
    />
    <div
        class="absolute inset-0 bg-linear-to-t from-background via-background/50 to-transparent"
    >
    </div>

    <Container class="relative z-10 py-20 md:py-28">
        <div class="flex flex-col items-center text-center gap-6">
            <span class="text-[11px] uppercase tracking-[0.35em] text-primary">
                HOMEIX Living Concept
            </span>
            <h1
                class="font-display text-4xl md:text-6xl lg:text-7xl text-foreground leading-tight"
            >
                Turning Spaces Into Comfort Homes
            </h1>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl">
                Premium F2C furniture — direct from our Nilambur studio, crafted
                for serene modern living.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a
                    href="/collections"
                    class="inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary-foreground transition hover:opacity-90"
                >
                    Explore Collection
                </a>
                <a
                    href="/contact"
                    class="inline-flex items-center justify-center border border-border px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-foreground transition hover:bg-card"
                >
                    Visit Our Studio
                </a>
            </div>
        </div>
    </Container>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-primary">
        <span class="material-symbols-outlined text-4xl"
            >keyboard_double_arrow_down</span
        >
    </div>
</section>
