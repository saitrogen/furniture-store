---
import Container from "./Container.astro";

interface Props {
    text: string;
}

const { text } = Astro.props;
---

<section class="border-y border-border bg-primary">
    <Container class="overflow-hidden">
        <div class="flex items-center whitespace-nowrap animate-marquee py-3">
            {
                Array.from({ length: 2 }).map(() => (
                    <div class="flex items-center">
                        {Array.from({ length: 4 }).map(() => (
                            <span class="mx-6 text-[11px] uppercase tracking-[0.2em] text-primary-foreground">
                                {text}
                            </span>
                        ))}
                    </div>
                ))
            }
        </div>
    </Container>
</section>
