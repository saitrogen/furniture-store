---
import Container from "./Container.astro";

const storyImage =
    "https://lh3.googleusercontent.com/aida-public/AB6AXuASV_DTLQYnFfyIGOEkXUn04KsSYUZ0VA-hRaG5oByVW6Q-H1vmn86dgu-gBGd9bKD3NbWx7NuQ6LOgq11CHmGCLoiJ7b71myiFxcicui5khmOURPolw9Bdcngs6UCoK5XsxOtzYRyIFBzm8xpo1MhO58aOnFobDZyF_uoAMpUu_SIHzyxJdDPB0fFAWW8znUgN2kTl_IKSaT06vAQe6WqO4vSoF7Ac3RpX5S6VjJhtjCBlcV1L1RVY001_bIWMTgYdOJ1HtTVVAkc5";

const stats = [
    { icon: "factory", label: "F2C Brand" },
    { icon: "star", label: "4.9★ Rating" },
    { icon: "groups", label: "119+ Customers" },
];
---

<section class="py-20 md:py-28">
    <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div
                class="overflow-hidden border border-border bg-card aspect-4/5"
            >
                <img
                    src={storyImage}
                    alt="HOMEIX craftsmanship"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
            </div>
            <div class="flex flex-col gap-6">
                <div>
                    <p
                        class="text-[11px] uppercase tracking-[0.35em] text-primary"
                    >
                        The HOMEIX Story
                    </p>
                    <h2
                        class="mt-4 font-display text-3xl md:text-5xl text-foreground"
                    >
                        Factory-to-consumer, rooted in Nilambur
                    </h2>
                </div>
                <p class="text-base md:text-lg text-muted-foreground">
                    Born in Kerala’s timber heartland, HOMEIX blends artisan
                    craft with modern restraint. We design and deliver premium
                    sofas and furniture directly from our factory floor to your
                    home.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    {
                        stats.map(({ icon, label }) => (
                            <div class="border border-border bg-card p-4 text-center">
                                <span class="material-symbols-outlined text-primary text-3xl">
                                    {icon}
                                </span>
                                <p class="mt-3 text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                                    {label}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </Container>
</section>
