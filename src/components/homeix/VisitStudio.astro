---
import Container from "./Container.astro";
---

<section class="py-20 md:py-28 border-t border-border">
    <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
            <div class="border border-border bg-card p-6 flex flex-col gap-6">
                <div>
                    <p
                        class="text-[11px] uppercase tracking-[0.35em] text-primary"
                    >
                        Find Us
                    </p>
                    <h2
                        class="mt-4 font-display text-3xl md:text-4xl text-foreground"
                    >
                        Visit Our Studio
                    </h2>
                </div>
                <div class="space-y-5 text-sm text-muted-foreground">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-primary"
                            >location_on</span
                        >
                        <span
                            >Vadapuram, Nilambur–Kozhikode Road, Malappuram,
                            Kerala – 676542</span
                        >
                    </div>
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-primary"
                            >call</span
                        >
                        <a
                            href="tel:+919961612120"
                            class="hover:text-foreground">+91 9961612120</a
                        >
                    </div>
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-primary"
                            >schedule</span
                        >
                        <span>Opens at 10:00 AM</span>
                    </div>
                </div>
                <a
                    href="https://wa.me/919961612120"
                    class="inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary-foreground transition hover:opacity-90 w-fit"
                >
                    Chat on WhatsApp
                </a>
            </div>
            <div
                class="border border-border bg-card aspect-4/3 relative overflow-hidden"
            >
                <div
                    class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
                >
                </div>
                <div
                    class="relative z-10 h-full w-full flex items-center justify-center"
                >
                    <div
                        class="flex flex-col items-center gap-3 text-muted-foreground"
                    >
                        <span
                            class="material-symbols-outlined text-primary text-4xl"
                            >location_away</span
                        >
                        <span class="text-[11px] uppercase tracking-[0.2em]"
                            >View on Google Maps</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </Container>
</section>
