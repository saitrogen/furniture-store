---
import Container from "./Container.astro";

const features = [
    {
        icon: "sell",
        title: "Factory Direct Pricing",
        description: "No middlemen, best price guaranteed.",
    },
    {
        icon: "local_shipping",
        title: "Free Home Delivery",
        description: "Delivered and set up at your doorstep.",
    },
    {
        icon: "workspace_premium",
        title: "Premium Materials",
        description: "Teak wood, premium fabric, long-lasting build.",
    },
    {
        icon: "grade",
        title: "4.9★ Rated",
        description: "Trusted by 119+ families across Kerala.",
    },
];
---

<section class="py-20 md:py-28">
    <Container>
        <div class="mb-10">
            <p class="text-[11px] uppercase tracking-[0.35em] text-primary">
                Why Choose HOMEIX
            </p>
            <h2 class="mt-4 font-display text-3xl md:text-5xl text-foreground">
                Made to elevate everyday living
            </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                features.map(({ icon, title, description }) => (
                    <div class="border border-border bg-card p-6 flex flex-col gap-4">
                        <span class="material-symbols-outlined text-primary text-3xl">
                            {icon}
                        </span>
                        <div>
                            <h3 class="font-display text-xl text-foreground">
                                {title}
                            </h3>
                            <p class="mt-2 text-sm text-muted-foreground">
                                {description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </Container>
</section>
