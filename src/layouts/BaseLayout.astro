---
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import ShadcnNavbar from "@/components/react/ShadcnNavbar";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
// Todo: add og image in public folder
const {
  title,
  description = "Premium handcrafted furniture from Nilambur, Kerala. Factory-direct to your home.",
  ogImage = "/og-default.jpg",
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang="en" class="lumen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@300;400;500;600;700"
    />

    <title>{title} — HOMEIX</title>
  </head>

  <body
    class="bg-background text-foreground font-sans antialiased min-h-screen"
  >

<ShadcnNavbar client:load />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
