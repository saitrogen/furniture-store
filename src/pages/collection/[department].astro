---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductGrid from "@/components/react/ProductGrid";
import { getDepartments } from "@/lib/catalog";
import type { GridProduct } from "@/components/react/ProductGrid";

export function getStaticPaths() {
  return getDepartments().map((dept) => ({
    params: { department: dept.slug },
    props: {
      name: dept.name,
      slug: dept.slug,
      count: dept.count,
      products: dept.products.map((p) => ({
        id: p.id,
        name: p.name,
        slug: p.slug,
        image: p.image,
        price: p.price,
        rating: p.rating,
        type: p.type,
        department: p.department,
      })) satisfies GridProduct[],
    },
  }));
}

const { name, slug, count, products } = Astro.props;
---

<BaseLayout title={name} description={`Explore ${name} — premium handcrafted furniture from HOMEIX.`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 pt-5 text-xs text-muted-foreground sm:pt-7">
      <a href="/" class="transition-colors hover:text-foreground">Home</a>
      <span>/</span>
      <a href="/collection" class="transition-colors hover:text-foreground">Collection</a>
      <span>/</span>
      <span class="text-foreground">{name}</span>
    </nav>

    <!-- Title -->
    <div class="mt-4 pb-6 sm:pb-8">
      <h1 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">{name}</h1>
      <p class="mt-1 text-sm text-muted-foreground">{count} products</p>
    </div>

    <div class="border-t border-border pt-6 pb-16 sm:pt-8">
      <ProductGrid
        client:load
        products={products}
        filterBy="type"
      />
    </div>
  </div>
</BaseLayout>
