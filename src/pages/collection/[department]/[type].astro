---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDepartments, getProductsByType } from "@/lib/catalog";

export function getStaticPaths() {
  return getDepartments().flatMap((department) =>
    department.types.map((type) => ({
      params: { department: department.slug, type: type.slug },
      props: {
        department,
        type,
        products: getProductsByType(department.slug, type.slug),
      },
    }))
  );
}

const { department, type, products } = Astro.props;
---

<BaseLayout title={type.name} description={`Explore ${type.name} in ${department.name} from HOMEIX.`}>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <a href={`/collection/${department.slug}`} class="text-sm font-medium text-primary hover:underline">← {department.name}</a>
    <div class="mt-8 max-w-3xl">
      <p class="text-sm uppercase tracking-[0.22em] text-muted-foreground">{department.name}</p>
      <h1 class="mt-3 text-5xl font-semibold leading-none text-foreground sm:text-6xl">{type.name}</h1>
      <p class="mt-5 text-lg leading-8 text-muted-foreground">
        {products.length} matching products. Open any item to send a pre-filled WhatsApp enquiry.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8">
    <div
      data-catalog-browser
      data-filter-mode="none"
      data-scope-department={department.slug}
      data-scope-type={type.slug}
      data-default-heading={type.name}
    >
      <div class="mb-5 grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-end">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Search & sort</p>
          <p data-catalog-count class="mt-1 text-sm font-medium text-foreground">{products.length} products</p>
        </div>

        <label class="flex flex-col gap-1 text-sm text-muted-foreground sm:min-w-52">
          <span>Search</span>
          <input
            data-catalog-search
            type="search"
            placeholder={`Search ${type.name}`}
            class="h-10 rounded-md border border-border bg-background px-3 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </label>

        <label class="flex flex-col gap-1 text-sm text-muted-foreground sm:min-w-48">
          <span>Sort</span>
          <select
            data-catalog-sort
            class="h-10 rounded-md border border-border bg-background px-3 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <option value="featured">Featured</option>
            <option value="price-low">Price: low to high</option>
            <option value="price-high">Price: high to low</option>
            <option value="rating">Top rated</option>
            <option value="name">Name A-Z</option>
          </select>
        </label>
      </div>

      <div data-catalog-filters class="hidden"></div>
      <h2 data-catalog-heading class="sr-only">{type.name}</h2>
      <div data-catalog-grid class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3"></div>
      <p data-catalog-status class="hidden rounded-lg border border-border bg-background p-6 text-center text-sm text-muted-foreground">
        No products found.
      </p>
      <div data-catalog-sentinel class="h-10"></div>
      <button
        type="button"
        data-catalog-load-more
        class="mx-auto mt-6 hidden min-h-11 items-center justify-center rounded-md border border-border bg-background px-5 text-sm font-medium text-foreground hover:bg-accent"
      >
        Load more
      </button>
    </div>
  </section>

  <script src="/catalog-browser.js" defer></script>
</BaseLayout>
