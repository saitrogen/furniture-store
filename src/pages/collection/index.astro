---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductGrid from "@/components/react/ProductGrid";
import { getProducts } from "@/lib/catalog";
import type { GridProduct } from "@/components/react/ProductGrid";

const products: GridProduct[] = getProducts().map((p) => ({
  id: p.id,
  name: p.name,
  slug: p.slug,
  image: p.image,
  price: p.price,
  rating: p.rating,
  type: p.type,
  department: p.department,
}));
---

<BaseLayout
  title="Collection"
  description="Browse the full HOMEIX furniture and décor collection."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 pt-5 text-xs text-muted-foreground sm:pt-7">
      <a href="/" class="transition-colors hover:text-foreground">Home</a>
      <span>/</span>
      <span class="text-foreground">Collection</span>
    </nav>

    <!-- Title -->
    <div class="mt-4 pb-6 sm:pb-8">
      <h1 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">All Products</h1>
      <p class="mt-1 text-sm text-muted-foreground">{products.length} products</p>
    </div>

    <div class="border-t border-border pt-6 pb-16 sm:pt-8">
      <ProductGrid
        client:load
        products={products}
        filterBy="department"
      />
    </div>
  </div>
</BaseLayout>
