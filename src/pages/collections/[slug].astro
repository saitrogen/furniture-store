---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/homeix/Container.astro";
import ProductCard from "@/components/ui/ProductCard.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const {
  title,
  price,
  category,
  material,
  dimensions,
  warranty,
  coverImage,
  images,
  whatsapp,
  relatedSlugs,
} = product.data;

const gallery = [coverImage, ...images].filter(Boolean);
const waMessage = encodeURIComponent(
  `Hi, I'm interested in the ${title} (₹${price.toLocaleString("en-IN")})`,
);
const waLink = `https://wa.me/${whatsapp}?text=${waMessage}`;

const allProducts = await getCollection("products");
const relatedProducts = allProducts
  .filter(
    (p) =>
      relatedSlugs.includes(p.data.slug) && p.data.slug !== product.data.slug,
  )
  .slice(0, 4);
---

<BaseLayout title={title}>
  <section class="pt-24 pb-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="overflow-hidden border border-border bg-card aspect-4/3">
            <img
              src={coverImage}
              alt={title}
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>
          <div class="grid grid-cols-4 gap-4">
            {
              gallery.map((image) => (
                <div class="overflow-hidden border border-border bg-card aspect-square">
                  <img
                    src={image}
                    alt={title}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-6">
          <span class="text-[11px] uppercase tracking-[0.35em] text-primary">
            {category.replace("-", " ")} Collections
          </span>
          <h1 class="font-display text-3xl md:text-4xl text-foreground">
            {title}
          </h1>
          <p class="font-display text-2xl text-primary">
            ₹{price.toLocaleString("en-IN")}
          </p>
          <div class="h-px bg-border"></div>
          <div class="text-muted-foreground leading-relaxed">
            <Content />
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={waLink}
              class="flex-1 inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary-foreground transition hover:opacity-90"
            >
              Order on WhatsApp
            </a>
            <a
              href="/contact"
              class="flex-1 inline-flex items-center justify-center border border-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary transition hover:bg-primary hover:text-primary-foreground"
            >
              Enquire Now
            </a>
          </div>
          <div class="border-t border-border pt-4 space-y-4">
            {
              ["Dimensions", "Materials & Care", "Shipping"].map((label) => (
                <div class="flex items-center justify-between text-sm text-muted-foreground">
                  <span class="uppercase tracking-[0.2em]">{label}</span>
                  <span class="material-symbols-outlined text-primary">
                    add
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-12 border-t border-border">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] text-primary">
            Material
          </p>
          <p class="text-sm text-muted-foreground">{material}</p>
        </div>
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] text-primary">
            Dimensions
          </p>
          <p class="text-sm text-muted-foreground">{dimensions}</p>
        </div>
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] text-primary">
            Warranty
          </p>
          <p class="text-sm text-muted-foreground">{warranty}</p>
        </div>
      </div>
    </Container>
  </section>

  {
    relatedProducts.length > 0 && (
      <section class="py-20">
        <Container>
          <div class="mb-8">
            <p class="text-[11px] uppercase tracking-[0.35em] text-primary">
              You May Also Like
            </p>
            <h2 class="mt-4 font-display text-3xl text-foreground">
              Curated companions
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {relatedProducts.map((related) => (
              <ProductCard product={related} />
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
