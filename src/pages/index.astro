---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroBanner from "@/components/react/HeroBanner";
import CategoryGrid from "@/components/react/CategoryGrid";
import ProductCarousel from "@/components/react/ProductCarousel";
import BentoGrid from "@/components/BentoGrid.astro";
import { heroSlides, heroBadges } from "@/content/localData/hero";
import { shopCategories } from "@/content/localData/shopCategories";
import { carouselConfigs } from "@/content/localData/carousels";
import { bentoTiles } from "@/content/localData/bento";
import type { CarouselProduct } from "@/components/react/ProductCarousel";
import products from "@/content/data/new/product.json";

const productMap = new Map(products.map((p) => [p.id, p]));

function resolveProducts(ids: string[]): CarouselProduct[] {
  return ids
    .map((id) => productMap.get(id))
    .filter(Boolean)
    .map((p) => ({
      name: p!.name,
      slug: p!.slug,
      image: p!.image,
      price: p!.price,
      rating: p!.rating,
      type: p!.type,
    }));
}

const [newArrivalsConfig, trendingConfig] = carouselConfigs;
const newArrivalsProducts = resolveProducts(newArrivalsConfig.productIds);
const trendingProducts   = resolveProducts(trendingConfig.productIds);
---

<BaseLayout
  title="Home"
  description="Premium handcrafted furniture — factory-direct from Nilambur, Kerala."
>
  <!-- Hero -->
  <section class="lg:mx-auto lg:max-w-7xl lg:px-6 lg:pt-5">
    <HeroBanner client:load slides={heroSlides} badges={heroBadges} />
  </section>

  <!-- Shop by Category -->
  <CategoryGrid
    client:load
    label="Quick navigation"
    title="Shop by Category"
    categories={shopCategories}
  />

  <!-- New Arrivals -->
  <ProductCarousel
    client:load
    title={newArrivalsConfig.title}
    subtitle={newArrivalsConfig.subtitle}
    viewAllHref={newArrivalsConfig.viewAllHref}
    products={newArrivalsProducts}
  />

  <!-- Editorial bento -->
  <BentoGrid
    label="Our story"
    title="Built different"
    tiles={bentoTiles}
  />

  <!-- Trending Now -->
  <ProductCarousel
    client:load
    title={trendingConfig.title}
    subtitle={trendingConfig.subtitle}
    viewAllHref={trendingConfig.viewAllHref}
    products={trendingProducts}
  />
</BaseLayout>
