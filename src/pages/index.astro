---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import { getCollection } from "astro:content";
import { Star, MapPin, Phone, Clock, ArrowRight, Quote } from "lucide-react";

// Fetch collections
const products = await getCollection("products");
const reviews = await getCollection("reviews");

// Mock Data from reference
const storeData = {
	name: "HOMEIX Sofa & Furniture Studio",
	tagline: "Premium Custom Sofas & Furniture in Malappuram",
	address: "Gudalur - Nilambur - Kozhikode Road, Vadapuram, Kerala 676542",
	phone: "+91 98765 43210",
	hours: "10:00 AM - 9:00 PM",
	rating: 4.9,
	totalReviews: 162,
	mapLink: "https://maps.app.goo.gl/YourExactMapLinkHere",
};
---

<Layout title="HOMEIX Sofa & Furniture Studio">
	<div
		class="min-h-screen bg-slate-50 font-sans text-slate-900 selection:bg-slate-900 selection:text-white"
	>
		<Navbar client:load storeLink={storeData.mapLink} />

		{/* HERO SECTION */}
		<section
			class="relative h-[85vh] min-h-150 w-full flex items-center justify-center overflow-hidden"
		>
			{/* Background Image with Overlay */}
			<div class="absolute inset-0 z-0">
				<img
					src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=80"
					alt="Modern living room furniture"
					class="w-full h-full object-cover object-center"
				/>
				<div class="absolute inset-0 bg-slate-900/40"></div>
			</div>

			{/* Hero Content */}
			<div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-16">
				<div
					class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white mb-6"
				>
					<Star className="w-4 h-4 text-yellow-400 fill-yellow-400" />
					<span class="text-sm font-medium tracking-wide"
						>4.9 Star Rated Studio in Vadapuram</span
					>
				</div>
				<h1
					class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 drop-shadow-md"
				>
					Elevate Your Space with <span class="text-slate-200 italic"
						>Custom</span
					> Furniture
				</h1>
				<p
					class="text-lg md:text-xl text-slate-100 mb-10 max-w-2xl mx-auto drop-shadow"
				>
					{storeData.tagline}. Discover our exclusive collection of
					hand-crafted sofas, dining sets, and bedroom essentials
					designed for comfort and style.
				</p>
				<div
					class="flex flex-col sm:flex-row gap-4 justify-center items-center"
				>
					<a
						href="#collections"
						class="w-full sm:w-auto px-8 py-4 bg-white text-slate-900 rounded-full font-semibold text-lg hover:bg-slate-100 transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2"
					>
						View Collections
					</a>
					<a
						href="#location"
						class="w-full sm:w-auto px-8 py-4 bg-transparent border-2 border-white text-white rounded-full font-semibold text-lg hover:bg-white/10 transition-all flex items-center justify-center gap-2"
					>
						Visit Store <ArrowRight className="w-5 h-5" />
					</a>
				</div>
			</div>
		</section>

		{/* FEATURED COLLECTIONS */}
		<section id="collections" class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold mb-4">
						Our Signature Collections
					</h2>
					<p class="text-slate-600 max-w-2xl mx-auto text-lg">
						Explore our wide range of premium furniture,
						meticulously crafted to transform your house into a
						home.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						products.map((product) => (
							<div class="group relative rounded-2xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300">
								<div class="aspect-4/3 w-full overflow-hidden bg-slate-100">
									<img
										src={product.data.image}
										alt={product.data.name}
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								</div>
								<div class="p-6 bg-white">
									<div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
										{product.data.category}
									</div>
									<h3 class="text-xl font-bold text-slate-900 group-hover:text-slate-700 transition-colors">
										{product.data.name}
									</h3>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* SOCIAL PROOF (REVIEWS) */}
		<section id="reviews" class="py-24 bg-slate-900 text-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6"
				>
					<div class="max-w-2xl">
						<h2 class="text-3xl md:text-4xl font-bold mb-4">
							Loved by our Community
						</h2>
						<p class="text-slate-400 text-lg">
							Don't just take our word for it. See what our
							customers in Malappuram have to say about our
							quality and service.
						</p>
					</div>
					<div
						class="flex items-center gap-3 bg-white/10 px-6 py-3 rounded-2xl border border-white/10"
					>
						<div class="text-4xl font-bold">{storeData.rating}</div>
						<div class="flex flex-col">
							<div class="flex gap-1 text-yellow-400">
								{
									Array.from({ length: 5 }).map((_, i) => (
										<Star
											key={i}
											className="w-4 h-4 fill-current"
										/>
									))
								}
							</div>
							<span class="text-sm text-slate-400"
								>Based on {storeData.totalReviews} reviews</span
							>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{
						reviews.map((review) => (
							<div class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-colors">
								<Quote className="w-10 h-10 text-slate-600 mb-6" />
								<div class="flex gap-1 text-yellow-400 mb-4">
									{Array.from({ length: 5 }).map((_, i) => (
										<Star
											key={i}
											className="w-4 h-4 fill-current"
										/>
									))}
								</div>
								<p class="text-slate-300 mb-8 leading-relaxed">
									"{review.body.trim()}"
								</p>
								<div class="flex justify-between items-center mt-auto">
									<span class="font-semibold text-white">
										{review.data.author}
									</span>
									<span class="text-sm text-slate-500">
										{review.data.date}
									</span>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* LOCATION & FOOTER */}
		<footer
			id="location"
			class="bg-white pt-24 pb-12 border-t border-slate-200"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-16">
					{/* Store Info */}
					<div>
						<div class="flex items-center gap-2 mb-8">
							<div
								class="w-10 h-10 bg-slate-900 rounded-xl flex items-center justify-center"
							>
								<span
									class="text-white font-bold text-2xl leading-none"
									>H</span
								>
							</div>
							<span
								class="font-bold text-3xl tracking-tight text-slate-900"
								>HOMEIX</span
							>
						</div>

						<p class="text-slate-600 text-lg mb-10 max-w-md">
							Your local destination for premium, custom-crafted
							furniture. Visit our studio to experience the
							quality firsthand.
						</p>

						<div class="space-y-6">
							<div class="flex items-start gap-4">
								<div
									class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center shrink-0"
								>
									<MapPin
										className="w-6 h-6 text-slate-900"
									/>
								</div>
								<div>
									<h4
										class="font-semibold text-slate-900 mb-1"
									>
										Visit Our Studio
									</h4>
									<p class="text-slate-600">
										{storeData.address}
									</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div
									class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center shrink-0"
								>
									<Clock className="w-6 h-6 text-slate-900" />
								</div>
								<div>
									<h4
										class="font-semibold text-slate-900 mb-1"
									>
										Opening Hours
									</h4>
									<p class="text-slate-600">
										{storeData.hours} (Open Daily)
									</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div
									class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center shrink-0"
								>
									<Phone className="w-6 h-6 text-slate-900" />
								</div>
								<div>
									<h4
										class="font-semibold text-slate-900 mb-1"
									>
										Contact Us
									</h4>
									<p class="text-slate-600">
										{storeData.phone}
									</p>
								</div>
							</div>
						</div>
					</div>

					{/* Map Placeholder */}
					<div
						class="bg-slate-100 rounded-3xl overflow-hidden min-h-100 relative flex flex-col items-center justify-center border border-slate-200"
					>
						<div
							class="absolute inset-0 opacity-40 mix-blend-multiply bg-[url('https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=1000&q=80')] bg-cover bg-center"
						>
						</div>
						<div
							class="relative z-10 text-center p-8 bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl max-w-xs mx-auto border border-slate-100"
						>
							<MapPin
								className="w-10 h-10 text-slate-900 mx-auto mb-4"
							/>
							<h3 class="font-bold text-xl mb-2 text-slate-900">
								Find Us on Maps
							</h3>
							<p class="text-slate-600 text-sm mb-6">
								Get directions to our Vadapuram studio.
							</p>
							<a
								href={storeData.mapLink}
								target="_blank"
								rel="noreferrer"
								class="block w-full py-3 px-6 bg-slate-900 text-white rounded-full font-medium hover:bg-slate-800 transition-colors"
							>
								Open Google Maps
							</a>
						</div>
					</div>
				</div>

				<div
					class="pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4"
				>
					<p class="text-slate-500 text-sm">
						© {new Date().getFullYear()} HOMEIX Sofa & Furniture Studio.
						All rights reserved.
					</p>
					<div class="text-slate-500 text-sm flex gap-4">
						<a
							href="#"
							class="hover:text-slate-900 transition-colors"
							>Privacy Policy</a
						>
						<a
							href="#"
							class="hover:text-slate-900 transition-colors"
							>Terms of Service</a
						>
					</div>
				</div>
			</div>
		</footer>
	</div>
</Layout>
