    feature:
        "https://lh3.googleusercontent.com/aida-public/AB6AXuBsn8A_b69pgjmNmbVkLnWVqyb5pLAVXpL5siuLtJwZ68pY1mcWYqoi5T0IAfg5BN07K5ZRm1n0BmMfnpHTFNKkWzQjtR3_M_p1OXz4W_NolYz3qw9eEu0lXIFim48GNYwxs6mpWWf1UJ7Ugmq9CF_5e0nNBEfV4snlVCZgHAx6aK4-htTSFiQyyZkPwbAG2wiBsE4tXdmMupq3Lq3u4tJAnTp2dKlDUaLA9XJpfAp3f-XoaUt0oXmN1mEupBcfzuiVVSJ8BOpJFe4-",
    dining: "https://lh3.googleusercontent.com/aida-public/AB6AXuC1oLvSwhNKaI37VngCxrh9dF1OCrKxAPatVl66qyDh2ilzqOcnHVYIOAwCJmnUek5owg9TTnD5POqKrYtv3szozsk8bSNk9OlWWqDZCTN1rUYQmufElOxXaTkU9xWvzNf1bw5LVoSjfOToxjUUdCAkn54QTEr9N9d-637eyw9nFk0Yc-5-Obh1MrBuEfG0xYdJR7oSjiSzpBxikxfjjnbVL_mvUf4XyB4AJlg62wSkJC-SlF6EuiPLuARtWQYPZXLJimp1t1-0im5k",
    accent: "https://lh3.googleusercontent.com/aida-public/AB6AXuBX1UfswldSIhuUsdL0KdDKXob0RuLOTC2qx1idD8hBoClRdnYo6H5prbYnmDFCZ9W4JEKy03I5cWeOE5EvzJx8U3T2rY9CjyGIGU3v1KptUgu16tdT-sk-upg-abnlHuK4I1IVseXB2jD42fcmA4E7D69iiJj4VzTNarV1WdLZ8DFvsKuG1rLPalGnJ7IJZR3hPYcgib9fz-l8u3Vl60-sskvnpNYIGnOhqxmEMzL5Y9TsFX_LBUrvBRz_4LSzm4ehhLtQr2T--X4B",
