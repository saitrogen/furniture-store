---

<BaseLayout title="Exclusive Offers">
    <PageHero
        eyebrow="Limited Time Deals"
        title="Exclusive Combo Packages"
        subtitle="Factory-direct bundles — maximum value, zero compromise."
        image="https://lh3.googleusercontent.com/aida/ADBb0uiEeOf6qsyragKJc2GAiGybJD3VBssOn0fjuHYlbF8APU4fQQ2k_XklCo4vQweSpuvQ5k4lPTiLA2sTR8hdkj4tdkHMNIN09jmxaoOY8rgSglCJvhctSLAwGpONOPdZvTxOpoIpD0DbgVNcn6HAcOeDoOg37YpC71ukp-NrBbGmvvpDBSLrukCXmeVG5bvRkqcArd5z50wLFgcKzRqXLgi_UdU9GK55AjSFxqvepKAUyCRquWRptTfS5BXVDHedyxFtu4mz9iCzgsA"
        cta={{ label: "Explore Offers", href: "#combos" }}
    />

    <MarqueeBanner text="Seasonal offer — free home delivery on all combos" />

    <section id="combos" class="py-20 md:py-28">
        <Container>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {combos.map((combo) => <ComboDealCard {...combo} />)}
            </div>
        </Container>
    </section>

    <section class="py-20 md:py-28 border-t border-border">
        <Container>
            <div class="text-center mb-12">
                <p class="text-[11px] uppercase tracking-[0.35em] text-primary">
                    Curated Selections
                </p>
                <h2
                    class="mt-4 font-display text-3xl md:text-5xl text-foreground"
                >
                    Design-led bundles
                </h2>
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[320px]"
            >
                <article
                    class="md:col-span-8 relative overflow-hidden border border-border bg-card flex flex-col"
                >
                    <img
                        src={curated.feature}
                        alt="Obsidian Collection"
                        class="absolute inset-0 h-full w-full object-cover"
                    />
                    <div
                        class="absolute inset-0 bg-linear-to-t from-background via-background/30 to-transparent"
                    >
                    </div>
                    <div
                        class="relative z-10 mt-auto p-6 flex items-end justify-between"
                    >
                        <div>
                            <span
                                class="text-[10px] uppercase tracking-[0.2em] text-primary"
                                >Living Concept</span
                            >
                            <h3
                                class="mt-2 font-display text-2xl text-foreground"
                            >
                                The Obsidian Collection
                            </h3>
                            <p class="text-sm text-muted-foreground">
                                Complete lounge suite featuring Italian aniline
                                leather.
                            </p>
                        </div>
                        <div class="text-right">
                            <span
                                class="text-xs text-muted-foreground line-through"
                                >₹12,400</span
                            >
                            <span
                                class="block font-display text-xl text-primary"
                                >₹9,800</span
                            >
                        </div>
                    </div>
                </article>
                <article
                    class="md:col-span-4 relative overflow-hidden border border-border bg-card flex flex-col"
                >
                    <img
                        src={curated.dining}
                        alt="Monolith Table Set"
                        class="absolute inset-0 h-full w-full object-cover"
                    />
                    <div
                        class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
                    >
                    </div>
                    <div class="relative z-10 mt-auto p-6">
                        <span
                            class="text-[10px] uppercase tracking-[0.2em] text-primary"
                            >Dining</span
                        >
                        <h3 class="mt-2 font-display text-xl text-foreground">
                            Monolith Table Set
                        </h3>
                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-sm text-foreground">₹4,200</span>
                            <span
                                class="text-[10px] uppercase tracking-[0.2em] text-primary"
                                >View Deal</span
                            >
                        </div>
                    </div>
                </article>
                <article
                    class="md:col-span-4 relative overflow-hidden border border-border bg-card flex flex-col"
                >
                    <img
                        src={curated.accent}
                        alt="Aura Lounge Chair"
                        class="absolute inset-0 h-full w-full object-cover"
                    />
                    <div
                        class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
                    >
                    </div>
                    <div class="relative z-10 mt-auto p-6">
                        <span
                            class="text-[10px] uppercase tracking-[0.2em] text-primary"
                            >Accent</span
                        >
                        <h3 class="mt-2 font-display text-xl text-foreground">
                            Aura Lounge Chair
                        </h3>
                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-sm text-foreground">₹1,850</span>
                            <span
                                class="text-[10px] uppercase tracking-[0.2em] text-primary"
                                >View Deal</span
                            >
                        </div>
                    </div>
                </article>
                <article
                    class="md:col-span-8 border border-primary bg-card flex items-center justify-center p-8 text-center"
                >
                    <div class="max-w-md">
                        <span
                            class="material-symbols-outlined text-primary text-4xl"
                            >auto_awesome</span
                        >
                        <h3 class="mt-4 font-display text-2xl text-foreground">
                            Bespoke Atelier Bundles
                        </h3>
                        <p class="mt-3 text-sm text-muted-foreground">
                            Work directly with our design consultants to create
                            a custom package tailored to your architectural
                            space. Receive up to 20% off on multi-room curation.
                        </p>
                        <a
                            href="/contact"
                            class="mt-6 inline-flex items-center justify-center border border-primary px-6 py-3 text-[11px] font-semibold tracking-[0.2em] uppercase text-primary hover:bg-primary hover:text-primary-foreground transition"
                        >
                            Schedule Consultation
                        </a>
                    </div>
                </article>
            </div>
        </Container>
    </section>
</BaseLayout>
