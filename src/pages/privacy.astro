---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy" description="HOMEIX privacy policy.">
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="text-sm uppercase tracking-[0.22em] text-muted-foreground">Privacy</p>
    <h1 class="mt-3 text-5xl font-semibold leading-none text-foreground">Privacy Policy</h1>
    <div class="mt-8 flex flex-col gap-5 text-base leading-7 text-muted-foreground">
      <p>This static website is designed for product browsing. It does not process checkout payments or customer accounts.</p>
      <p>When you use a WhatsApp enquiry link, your conversation is handled by WhatsApp and any details you share there are used to respond to your enquiry.</p>
      <p>Basic hosting analytics may be used to understand page visits and improve the catalogue experience.</p>
    </div>
  </section>
</BaseLayout>
