---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Terms" description="HOMEIX website terms.">
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="text-sm uppercase tracking-[0.22em] text-muted-foreground">Terms</p>
    <h1 class="mt-3 text-5xl font-semibold leading-none text-foreground">Terms & Conditions</h1>
    <div class="mt-8 flex flex-col gap-5 text-base leading-7 text-muted-foreground">
      <p>Product images, prices, ratings, and availability are shown for catalogue browsing and can be confirmed through WhatsApp enquiry.</p>
      <p>Final pricing, delivery, installation, finish selection, and custom sizing are confirmed directly before order acceptance.</p>
      <p>External WhatsApp links open a third-party service with its own terms and privacy practices.</p>
    </div>
  </section>
</BaseLayout>
